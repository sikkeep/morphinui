    {
      "name": "tokens",
      "type": "registry:item",
      "title": "Morphin tokens",
      "description": "The extra tokens Morphin components need on top of a shadcn theme: hover and pressed states derived from your colors, a third text level, status colors (and softer success and failure colors for light surfaces), the brand color, disabled states, the corner shape and the menu shadow. Existing values are never overwritten.",
      "categories": [
        "foundation",
        "theming",
        "design-tokens"
      ],
      "cssVars": {
        "theme": {
          "color-primary-hover": "var(--primary-hover)",
          "color-primary-active": "var(--primary-active)",
          "color-secondary-hover": "var(--secondary-hover)",
          "color-secondary-active": "var(--secondary-active)",
          "color-brand": "var(--brand)",
          "color-brand-foreground": "var(--brand-foreground)",
          "color-brand-hover": "var(--brand-hover)",
          "color-brand-active": "var(--brand-active)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "color-destructive-hover": "var(--destructive-hover)",
          "color-destructive-active": "var(--destructive-active)",
          "color-disabled": "var(--disabled)",
          "color-disabled-foreground": "var(--disabled-foreground)",
          "shadow-popover": "var(--popover-shadow)",
          "color-subtle-foreground": "var(--subtle-foreground)",
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "color-warning": "var(--warning)",
          "color-warning-foreground": "var(--warning-foreground)",
          "color-info": "var(--info)",
          "color-info-foreground": "var(--info-foreground)",
          "color-success-soft": "var(--success-soft)",
          "color-destructive-soft": "var(--destructive-soft)",
          "text-2xs": "0.6875rem",
          "text-2xs--line-height": "0.75rem",
          "text-2xs--letter-spacing": "0.02em",
          "color-field": "var(--field)",
          "color-field-border": "var(--field-border)",
          "color-surface-raised": "var(--surface-raised)",
          "color-menu": "var(--menu)"
        },
        "light": {
          "primary-hover": "color-mix(in oklch, var(--primary), white 12%)",
          "primary-active": "color-mix(in oklch, var(--primary), black 15%)",
          "secondary-hover": "color-mix(in oklch, var(--secondary), var(--foreground) 6%)",
          "secondary-active": "color-mix(in oklch, var(--secondary), var(--foreground) 10%)",
          "destructive-hover": "color-mix(in oklch, var(--destructive), black 12%)",
          "destructive-active": "color-mix(in oklch, var(--destructive), black 22%)",
          "disabled": "var(--muted)",
          "disabled-foreground": "color-mix(in oklch, var(--muted-foreground), var(--muted) 30%)",
          "brand": "#2563eb",
          "brand-foreground": "#ffffff",
          "brand-hover": "#1d4ed8",
          "brand-active": "#1e40af",
          "destructive-foreground": "#ffffff",
          "corner-shape": "superellipse(1.2)",
          "popover-shadow": "0 0 0 1px color-mix(in oklch, var(--foreground) 7%, transparent), 0 2px 4px -1px oklch(0 0 0 / 0.06), 0 6px 16px -4px oklch(0 0 0 / 0.06)",
          "subtle-foreground": "color-mix(in oklch, var(--muted-foreground), var(--background) 35%)",
          "success": "#1f8a4c",
          "success-foreground": "#ffffff",
          "warning": "#c2620a",
          "warning-foreground": "#ffffff",
          "info": "#2d63d6",
          "info-foreground": "#ffffff",
          "success-soft": "color-mix(in oklch, var(--success), white 38%)",
          "destructive-soft": "color-mix(in oklch, var(--destructive), white 38%)",
          "field": "var(--background)",
          "field-border": "var(--input)",
          "surface-raised": "var(--popover)",
          "menu": "var(--popover)"
        },
        "dark": {
          "primary-hover": "color-mix(in oklch, var(--primary), white 12%)",
          "primary-active": "color-mix(in oklch, var(--primary), black 15%)",
          "secondary-hover": "color-mix(in oklch, var(--secondary), var(--foreground) 6%)",
          "secondary-active": "color-mix(in oklch, var(--secondary), var(--foreground) 10%)",
          "destructive-hover": "color-mix(in oklch, var(--destructive), black 12%)",
          "destructive-active": "color-mix(in oklch, var(--destructive), black 22%)",
          "disabled": "var(--muted)",
          "disabled-foreground": "color-mix(in oklch, var(--muted-foreground), var(--muted) 30%)",
          "destructive-foreground": "color-mix(in oklch, var(--destructive), black 75%)",
          "popover-shadow": "0 0 0 1px color-mix(in oklch, var(--foreground) 10%, transparent), 0 8px 24px -6px oklch(0 0 0 / 0.3)",
          "subtle-foreground": "color-mix(in oklch, var(--muted-foreground), var(--background) 22%)",
          "success": "#5fcf8c",
          "success-foreground": "#0f2a1a",
          "warning": "#f0a55a",
          "warning-foreground": "#2f1a06",
          "info": "#7aa5ff",
          "info-foreground": "#0d1a33",
          "success-soft": "var(--success)",
          "destructive-soft": "var(--destructive)",
          "field": "var(--card)",
          "field-border": "var(--border)",
          "surface-raised": "color-mix(in oklch, var(--card), var(--foreground) 8%)",
          "menu": "color-mix(in srgb, var(--foreground) 5%, var(--background))",
          "brand": "#60a5fa",
          "brand-foreground": "#081b35",
          "brand-hover": "#93c5fd",
          "brand-active": "#3b82f6"
        }
      }
